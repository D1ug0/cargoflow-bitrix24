# Runtime
NODE_ENV=development
API_PORT=3001
NUXT_PUBLIC_API_BASE=http://localhost:3001
LOG_LEVEL=info

# PostgreSQL
POSTGRES_DB=cargoflow
POSTGRES_USER=cargoflow
POSTGRES_PASSWORD=cargoflow
DATABASE_URL=postgresql://cargoflow:cargoflow@postgres:5432/cargoflow?schema=public

# Messaging / cache
RABBITMQ_URL=amqp://cargoflow:cargoflow@rabbitmq:5672
RABBITMQ_EXCHANGE=cargoflow.events
RABBITMQ_QUEUE=cargoflow.worker
REDIS_URL=redis://redis:6379
WEBHOOK_IDEMPOTENCY_TTL_SECONDS=86400

# Bitrix24. Never commit real values.
# Base of an inbound webhook, ending before the REST method name.
BITRIX_WEBHOOK_URL=https://example.bitrix24.ru/rest/1/replace-me
# Token shown by the Bitrix24 outbound webhook or local application.
BITRIX_APPLICATION_TOKEN=replace-me
BITRIX_ENTITY_TYPE_ID=2
BITRIX_CATEGORY_ID=

# Portal-specific custom field codes. Obtain them after creating CRM fields.
BITRIX_FIELD_EXTERNAL_TRIP_ID=ufCrmExternalTripId
BITRIX_FIELD_INTEGRATION_STATUS=ufCrmIntegrationStatus
BITRIX_FIELD_LAST_SYNC_AT=ufCrmLastSyncAt
BITRIX_FIELD_INTEGRATION_ERROR=ufCrmIntegrationError
BITRIX_FIELD_FROM_CITY=ufCrmFromCity
BITRIX_FIELD_TO_CITY=ufCrmToCity
BITRIX_FIELD_LOADING_DATE=ufCrmLoadingDate
BITRIX_FIELD_DELIVERY_DATE=ufCrmDeliveryDate
BITRIX_FIELD_VEHICLE_TYPE=ufCrmVehicleType
BITRIX_FIELD_WEIGHT=ufCrmWeight
BITRIX_FIELD_TEMPERATURE=ufCrmTemperature

# Portal-specific stage codes.
BITRIX_STAGE_ASSIGNED=
BITRIX_STAGE_LOADING=
BITRIX_STAGE_IN_TRANSIT=
BITRIX_STAGE_DELIVERED=
BITRIX_STAGE_CLOSED=
BITRIX_STAGE_CANCELLED=

# Optional observability
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

