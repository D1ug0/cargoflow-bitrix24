{
  "note": "Actual UF codes are generated by the portal. Save returned camelCase codes in .env.",
  "sections": [
    {
      "name": "Маршрут",
      "fields": [
        {
          "label": "Город погрузки",
          "type": "string",
          "required": true,
          "env": "BITRIX_FIELD_FROM_CITY"
        },
        { "label": "Адрес погрузки", "type": "string" },
        {
          "label": "Город выгрузки",
          "type": "string",
          "required": true,
          "env": "BITRIX_FIELD_TO_CITY"
        },
        { "label": "Адрес выгрузки", "type": "string" },
        { "label": "Расстояние, км", "type": "double" }
      ]
    },
    {
      "name": "Груз",
      "fields": [
        { "label": "Название груза", "type": "string", "required": true },
        { "label": "Тип груза", "type": "enumeration" },
        { "label": "Вес, т", "type": "double", "env": "BITRIX_FIELD_WEIGHT" },
        { "label": "Объём, м³", "type": "double" },
        { "label": "Температурный режим", "type": "string", "env": "BITRIX_FIELD_TEMPERATURE" },
        { "label": "Опасный груз", "type": "boolean" }
      ]
    },
    {
      "name": "Перевозка",
      "fields": [
        {
          "label": "Дата погрузки",
          "type": "datetime",
          "required": true,
          "env": "BITRIX_FIELD_LOADING_DATE"
        },
        {
          "label": "Дата доставки",
          "type": "datetime",
          "required": true,
          "env": "BITRIX_FIELD_DELIVERY_DATE"
        },
        { "label": "Срочность", "type": "enumeration", "items": ["Обычная", "Срочная"] },
        {
          "label": "Тип автомобиля",
          "type": "enumeration",
          "items": ["Тент", "Рефрижератор", "Изотерм", "Фургон"],
          "env": "BITRIX_FIELD_VEHICLE_TYPE"
        }
      ]
    },
    {
      "name": "Автомобиль",
      "fields": [
        { "label": "Vehicle ID", "type": "string" },
        { "label": "Госномер", "type": "string" },
        { "label": "Водитель", "type": "string" },
        { "label": "Телефон водителя", "type": "string" }
      ]
    },
    {
      "name": "Финансы",
      "fields": [
        { "label": "Стоимость", "type": "money" },
        { "label": "Себестоимость", "type": "money" },
        { "label": "Маржинальность, %", "type": "double" },
        { "label": "Скидка, %", "type": "double" },
        {
          "label": "Статус оплаты",
          "type": "enumeration",
          "items": ["Не выставлено", "Счёт выставлен", "Частично оплачено", "Оплачено"]
        }
      ]
    },
    {
      "name": "Интеграция",
      "fields": [
        { "label": "External Trip ID", "type": "string", "env": "BITRIX_FIELD_EXTERNAL_TRIP_ID" },
        {
          "label": "Integration Status",
          "type": "string",
          "allowedValues": ["PENDING", "SYNCED", "ERROR"],
          "env": "BITRIX_FIELD_INTEGRATION_STATUS"
        },
        { "label": "Last Sync At", "type": "datetime", "env": "BITRIX_FIELD_LAST_SYNC_AT" },
        { "label": "Integration Error", "type": "string", "env": "BITRIX_FIELD_INTEGRATION_ERROR" }
      ]
    }
  ]
}
